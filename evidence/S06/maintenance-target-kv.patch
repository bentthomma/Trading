+// Full replacement also rolls back generic KV records (journal cursors, pending
+// costs and future state namespaces). Bind their exact bytes, without guessing
+// which unknown keys are "safe" to omit. Only a digest enters the private job;
+// keys and values are never exposed by the preview. Ordered framing is stable
+// across physical SQLite row order and distinguishes insertion/deletion/edit.
+function targetKvDigest(db){
+  const hash=createHash('sha256').update('trading-local-restore-target-kv:v1\n');
+  for(const row of db.prepare('SELECT key,value FROM kv ORDER BY key COLLATE BINARY').iterate())
+    hash.update(JSON.stringify([row.key,row.value])+'\n');
+  return hash.digest('hex');
+}
