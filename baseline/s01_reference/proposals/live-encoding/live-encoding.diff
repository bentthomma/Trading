+// RFC 9110 sections 5.6.1, 8.4.1.3, 12.4.2 and 12.5.3.
+// Local policy: prefer identity for an absent field; reject malformed weights;
+// use the lowest weight for duplicate coding entries, including x-gzip aliases.
+function acceptedEncodings(value){
+ if(value===undefined)return {valid:true,gzip:0,identity:1};
+ if(Array.isArray(value)){
+  if(!value.every(v=>typeof v==='string'))return {valid:false};
+  value=value.join(',');
+ }
+ if(typeof value!=='string')return {valid:false};
+ const weights=new Map();
+ for(const item of value.split(',')){
+  const part=item.replace(/^[ \t]+|[ \t]+$/g,'');
+  if(!part)continue;
+  const match=/^([!#$%&'*+\-.^_`|~0-9A-Za-z]+)(?:[ \t]*;[ \t]*q=(0(?:\.\d{0,3})?|1(?:\.0{0,3})?))?$/i.exec(part);
+  if(!match)return {valid:false};
+  let coding=match[1].toLowerCase();
+  if(coding==='x-gzip')coding='gzip';
+  const q=match[2]===undefined?1:Number(match[2]);
+  weights.set(coding,Math.min(weights.get(coding)??1,q));
+ }
+ return {valid:true,gzip:weights.get('gzip')??weights.get('*')??0,
+  identity:weights.get('identity')??(weights.get('*')===0?0:1)};
+}
