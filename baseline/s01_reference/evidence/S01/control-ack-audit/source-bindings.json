  "exact_edits": [
    {
      "old": "status='pending' AND expires_at<?",
      "new": "status='pending' AND expires_at<=?"
    },
    {
      "old": "    const next=this.db.prepare(\"SELECT * FROM proposals WHERE bot_id=? AND runtime_id=? AND status='pending' AND expires_at>=? ORDER BY confirmed_at LIMIT 1\").get(b.id,runtimeId,this.now());",
      "new": "    // Bind deadline selection and response metadata to one decision instant.\n    // The native callback still checks its current clock before applying.\n    const responseTime=this.now();\n    const next=this.db.prepare(\"SELECT * FROM proposals WHERE bot_id=? AND runtime_id=? AND status='pending' AND expires_at>? ORDER BY confirmed_at LIMIT 1\").get(b.id,runtimeId,responseTime);"
    },
